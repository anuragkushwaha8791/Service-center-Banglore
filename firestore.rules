rules_version = '2';

// Service Center CRM — Firestore Security Rules (Spark / free plan friendly)
// Publish: Firebase Console → Firestore Database → Rules → paste → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() {
      return request.auth != null;
    }
    // Owner = fixed owner e-mail (same as OWNER in index.html)
    function isOwner() {
      return signedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email.lower() == 'operations194@mooving.com';
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function me() {
      return get(profilePath()).data;
    }
    // account needs a profile created by Owner/Admin and must not be disabled
    function active() {
      return isOwner() || (hasProfile() && me().get('disabled', false) != true);
    }
    function isAdmin() {
      return active() && (isOwner() || me().get('role', 'user') == 'admin');
    }
    // "Custom access" assigned by Admin in Users → Access (field users/{uid}.acc)
    function modern() {
      return me().get('acc', null) != null;
    }
    function acc() {
      return me().get('acc', {});
    }
    // default rights from Admin Settings → User Permissions (used when a user has no custom access)
    function perm(p) {
      return !exists(/databases/$(database)/documents/config/permissions)
        || get(/databases/$(database)/documents/config/permissions).data.get(p, true) != false;
    }

    /* ---------- repair data (all locations) ---------- */
    // battery_repairs / charger_repairs = Bangalore ; <locationId>_battery_repairs / <locationId>_charger_repairs = other locations
    function isRepairCol(col) {
      return col in ['battery_repairs', 'charger_repairs']
        || col.matches('[a-z0-9]{2,14}_(battery|charger)_repairs');
    }
    function colLoc(col) {
      return (col in ['battery_repairs', 'charger_repairs']) ? 'bangalore' : col.split('_')[0];
    }
    // right p: v = view, a = add, e = edit, d = delete   (Admin / Owner: everything)
    function colOk(col, p) {
      return isAdmin() || (active() && (
        modern()
          ? (p in acc().get('cols', {}).get(col, []))
          : (me().get('location', '') == colLoc(col)
              && (p == 'v' || (p == 'a' && perm('userAdd')) || (p == 'e' && perm('userEdit'))))
      ));
    }

    // A delete is only allowed together (same batch) with a verbatim copy in deleted_entries/<collection>__<id>.
    // The archive can never be edited or deleted, so every deletion can be restored by the Owner.
    function archPath(col, docId) {
      return /databases/$(database)/documents/deleted_entries/$(col + '__' + docId);
    }
    function archived(col, docId) {
      return !exists(archPath(col, docId)) && existsAfter(archPath(col, docId))
        && getAfter(archPath(col, docId)).data.diff(resource.data).affectedKeys()
             .hasOnly(['_collection', '_docId', '_deletedBy', '_deletedByName', '_deletedAt']);
    }

    match /{col}/{docId} {
      allow read:   if isRepairCol(col) && colOk(col, 'v');
      // Owner may also restore archived entries (keeps their original creator)
      allow create: if isRepairCol(col) && request.resource.data.keys().size() <= 120
                    && (isOwner()
                        || (colOk(col, 'a') && request.resource.data.get('createdBy', '') == request.auth.uid));
      allow update: if isRepairCol(col) && colOk(col, 'e') && request.resource.data.keys().size() <= 120
                    && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      allow delete: if isRepairCol(col) && colOk(col, 'd') && archived(col, docId);
    }

    /* ---------- users ---------- */
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() && (
        // Owner creates / repairs his own profile
        (isOwner() && request.auth.uid == uid && request.resource.data.role == 'owner')
        // Admin creates users; only Owner can create admins
        || (isAdmin() && request.auth.uid != uid
            && (request.resource.data.role == 'user'
                || (isOwner() && request.resource.data.role == 'admin')))
      );

      allow update: if signedIn() && (
        (isOwner() && request.auth.uid == uid && request.resource.data.role == 'owner')
        // everyone may rename himself, nothing else
        || (request.auth.uid == uid && active()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        // Owner manages every non-owner account
        || (isOwner() && resource.data.role != 'owner'
            && request.resource.data.role in ['user', 'admin'])
        // Admin manages normal users only (name / home location / enable-disable / custom access)
        || (isAdmin() && resource.data.role == 'user' && request.resource.data.role == 'user'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'disabled', 'acc']))
      );

      allow delete: if false;
    }

    /* ---------- settings (dropdowns, columns, locations, permissions, branding, backup info) ---------- */
    match /config/{id} {
      allow read:   if active();
      allow write:  if isAdmin();
      // delegated "Edit dropdowns / columns": only the keys Admin ticked for that user (acc.setKeys)
      allow create: if active() && modern() && (id == 'options' || id == 'fields')
                    && request.resource.data.keys().hasOnly(acc().get('setKeys', []));
      allow update: if active() && modern() && (id == 'options' || id == 'fields')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(acc().get('setKeys', []));
    }

    /* ---------- inventory ---------- */
    // inventory/{locationId}      : stock added (Excel import, restock, corrections)  — Admin or users with "Manage stock"
    // inventory_use/{locationId}  : parts used in repair entries — updated automatically when an entry is saved
    function invList(locId) {
      return acc().get('inv', {}).get(locId, []);
    }
    function invView(locId) {
      return isAdmin() || (active() && (
        modern()
          ? ('v' in invList(locId) || 'e' in invList(locId))
          : me().get('location', '') == locId));
    }
    function invManage(locId) {
      return isAdmin() || (active() && modern() && 'e' in invList(locId));
    }
    function colHas(c, p) {
      return p in acc().get('cols', {}).get(c, []);
    }
    // can this user save entries in a section of that location? (needed for the automatic stock deduction)
    function canUseStock(locId) {
      return isAdmin() || (active() && (
        modern()
          ? (colHas(locId + '_battery_repairs', 'a') || colHas(locId + '_battery_repairs', 'e')
              || colHas(locId + '_charger_repairs', 'a') || colHas(locId + '_charger_repairs', 'e')
              || (locId == 'bangalore'
                  && (colHas('battery_repairs', 'a') || colHas('battery_repairs', 'e')
                      || colHas('charger_repairs', 'a') || colHas('charger_repairs', 'e'))))
          : (me().get('location', '') == locId && (perm('userAdd') || perm('userEdit')))));
    }
    // anyone who can save entries in that location may also READ the stock docs (needed for the automatic deduction)
    match /inventory/{locId} {
      allow read:  if invView(locId) || canUseStock(locId);
      allow write: if invManage(locId);
    }
    match /inventory_use/{locId} {
      allow read:   if invView(locId) || canUseStock(locId);
      allow create: if invManage(locId)
                    || (canUseStock(locId) && request.resource.data.keys().hasOnly(['used', 'updatedAt']));
      allow update: if invManage(locId)
                    || (canUseStock(locId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'updatedAt']));
      allow delete: if isAdmin();
    }

    /* ---------- activity log (entries older than 40 days are deleted automatically by the app) ---------- */
    // Tamper-proof audit trail: server time only, cannot be edited, and cannot be deleted before it is 39 days old.
    match /logs/{id} {
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'action', 'detail', 'ts'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.ts == request.time
                    && request.resource.data.action is string && request.resource.data.action.size() <= 120
                    && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow get, list: if active() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() && resource.data.ts < request.time - duration.value(39, 'd');
    }

    /* ---------- safety archive of deleted entries (never editable / deletable) ---------- */
    match /deleted_entries/{id} {
      allow create: if (isAdmin()
                        || (active() && modern() && colHas(request.resource.data.get('_collection', ''), 'd')))
                    && request.resource.data.get('_deletedBy', '') == request.auth.uid
                    && id == request.resource.data.get('_collection', '') + '__' + request.resource.data.get('_docId', '');
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // everything else is denied by default
  }
}
